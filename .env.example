# Telegram API credentials (https://my.telegram.org/apps)
# ОБЯЗАТЕЛЬНЫЕ параметры:
API_ID=
API_HASH=
OWNER_ID=

# String session (опционально — если пусто, создаётся новый файл сессии)
# STRING_SESSION=

# Web server port (default: 8080)
# PORT=8080


# Media download directory (default: ./media)
# MEDIA_DIR=./media

# Pрокси для скачивания (опционально). Формат: http://host:port, socks5://host:port,
# с авторизацией: http://user:pass@host:port
# PROXY=http://192.168.1.1:8080

# Список прокси через запятую — бот попробует каждый по очереди до успеха
# PROXY_LIST=http://1.2.3.4:8080,https://5.6.7.8:8080,socks5://9.0.1.2:1080

# YouTube cookies в формате Netscape — на старте пишутся в cookies.txt.
# Приоритетнее файла cookies.txt; удобно на Render (файл не хранится в git).
# Вставь содержимое экспортированного cookies.txt сюда, как одну многострочную переменную:
YOUTUBE_COOKIES=
# # Netscape HTTP Cookie File
# .youtube.com	TRUE	/	TRUE	0	SID	.....
# .youtube.com	TRUE	/	TRUE	0	SSID	...

# Или base64-кодированное содержимое cookies.txt:
# COOKIES_B64=
