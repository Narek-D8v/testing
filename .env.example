# ─── Обязательные параметры Telegram ───
API_ID=
API_HASH=
OWNER_ID=

# Сессия Telethon. Если пусто — создаётся файл my_userbot.session.
# STRING_SESSION=

# ─── Веб-статус ───
# PORT=8080
# HOST=0.0.0.0
# Токен для GET /stats?token=... ; без токена — только localhost.
# WEB_TOKEN=

# ─── Хранилище и файлы ───
# MEDIA_DIR=./media
# MAX_FILE_SIZE_MB=4096
# BOT_LANG=ru
# UPDATE_YTDLP=1

# ─── Внешний бот уведомлений ───
# Без токена и chat_id все алерты отключены.
# NOTIFY_BOT_TOKEN=
# NOTIFY_CHAT_ID=
# NOTIFY_ONLINE_WATCH=1
# NOTIFY_SESSIONS=1
# NOTIFY_PROTECT=1
# NOTIFY_PM_DELETE=1
# NOTIFY_PM_EDIT=1
# NOTIFY_PM_MEDIA=1
# NOTIFY_ERRORS=1

# ─── ONWATCH ───
# ONWATCH_MIN_INTERVAL=1
# ONWATCH_FIRE_COOLDOWN=3
# ONWATCH_REENTRY_MIN_GAP=1

# ─── AI ───
# Ключи необязательны: без них AI-команды отвечают понятной ошибкой.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat:free
# AI_TEMPERATURE=0.9
# AI_MAX_HISTORY=200
# AI_AUTO_COOLDOWN=15
# AI_TTS_VOICE=ru-RU-SvetlanaNeural
# AI_HISTORY_PER_PEER=1500
# AI_HISTORY_TOTAL=50000
# AI_REACTIONS=1

# ─── Сеть /Cookies ───
# PROXY=http://host:port
# PROXY_LIST=http://1.2.3.4:8080,socks5://9.0.1.2:1080
# YOUTUBE_COOKIES= (содержимое cookies.txt в формате Netscape)
# COOKIES_B64= (то же, но base64; приоритет у YOUTUBE_COOKIES)
